{
  "name": "ypbin-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ypbin 官方网站与文档门户",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "docs:config": "node scripts/generate-config-docs.mjs",
    "docs:sync-metadata": "node scripts/sync-starter-config-metadata.mjs",
    "docs:check-metadata": "node scripts/sync-starter-config-metadata.mjs --check",
    "screenshots:validate": "node tools/screenshots/validate-manifest.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check:content": "node scripts/check-content.mjs",
    "check": "pnpm docs:config && pnpm screenshots:validate && pnpm typecheck && pnpm check:content && pnpm build",
    "dev": "vitepress dev docs",
    "build": "node scripts/inject-versions.mjs inject && vitepress build docs && node scripts/inject-versions.mjs restore && pagefind --site docs/.vitepress/dist",
    "preview": "vitepress preview docs",
    "screenshots:capture": "node tools/screenshots/capture-admin-ui.mjs",
    "search:pagefind": "pnpm dlx pagefind@1.5.2 --site docs/.vitepress/dist"
  },
  "dependencies": {
    "@pagefind/default-ui": "1.5.2",
    "shiki": "2.1.0",
    "vitepress": "1.6.4",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "pagefind": "1.5.2",
    "sharp": "0.35.4",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.11",
    "wrangler": "4.131.1"
  }
}
