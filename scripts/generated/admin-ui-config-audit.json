    {"key":"request.authApiCredentials","type":"POST argument configuration","defaultValue":{"refresh":"post('/auth/refresh', {withCredentials:true})","logout":"post('/auth/logout', {withCredentials:true})"},"requiredWhen":"refresh or logout is called","description":"当前 refresh/logout 调用形式。","allowedValues":[],"safetyNotes":["withCredentials 被当作请求 body，不是 Axios config；跨域 Cookie 不会按预期携带。","logout 使用裸客户端且不携带 Bearer token。","logout 错误被本地退出流程吞掉，服务端 token 可能未撤销。"],"sources":[{"path":"apps/web-antd/src/api/core/auth.ts","lines":"74-90"},{"path":"apps/web-antd/src/store/auth.ts","lines":"99-117"},{"path":"packages/effects/request/src/request-client/request-client.ts","lines":"123-129"}],"category":"request","scope":"project"},
    {"key":"router.history","type":"RouterHistory","defaultValue":{"development":"createWebHistory(VITE_BASE)","production":"createWebHashHistory(VITE_BASE)","analyze":"createWebHistory(VITE_BASE)"},"requiredWhen":"router is created","description":"项目按 VITE_ROUTER_HISTORY 选择 history 实现。","allowedValues":["hash","history"],"safetyNotes":["开发和生产 URL/回调行为不同。"],"sources":[{"path":"apps/web-antd/src/router/index.ts","lines":"15-20"},{"path":"apps/web-antd/.env.production","lines":"12-13"}],"category":"routing","scope":"project"},
    {"key":"router.coreRoutes","type":"RouteRecordRaw[]","defaultValue":["/","/profile","/auth/login","/auth/code-login","/auth/qrcode-login","/auth/forget-password","/auth/register","/auth/social-callback","/:path(.*)*"],"requiredWhen":"router initializes","description":"静态核心、认证和 fallback 路由；首页重定向到 defaultHomePath。","allowedValues":[],"safetyNotes":["初始 Router 不注册 modules 中的业务路由。"],"sources":[{"path":"apps/web-antd/src/router/routes/core.ts","lines":"12-114"},{"path":"apps/web-antd/src/router/routes/index.ts","lines":"21-30"}],"category":"routing","scope":"project"},
    {"key":"router.accessMode","type":"frontend | backend | mixed","defaultValue":"backend","requiredWhen":"first authenticated navigation","description":"项目强制后端动态菜单模式。","allowedValues":["frontend","backend","mixed"],"safetyNotes":["apps/web-antd 路由 modules 不是当前菜单权威，权威是后端 /menu/all。"],"sources":[{"path":"apps/web-antd/src/preferences.ts","lines":"21-27"},{"path":"apps/web-antd/src/router/access.ts","lines":"17-40"}],"category":"routing","scope":"project"},
    {"key":"router.backendMenu","type":"dynamic route generation configuration","defaultValue":{"endpoint":"GET /menu/all","pageMap":"../views/**/*.vue","layouts":["BasicLayout","IFrameView"],"forbidden":"403 component"},"requiredWhen":"accessMode=backend","description":"后端菜单映射为 Vue 路由、注册后生成菜单。","allowedValues":[],"safetyNotes":["component 找不到会记录错误并替换为内嵌 404，而非 fail-fast。","route name 缺失只记录错误。"],"sources":[{"path":"apps/web-antd/src/api/core/menu.ts","lines":"5-10"},{"path":"apps/web-antd/src/router/access.ts","lines":"17-40"},{"path":"packages/utils/src/helpers/generate-routes-backend.ts","lines":"32-89"}],"category":"routing","scope":"project"},
    {"key":"router.accessGuard","type":"navigation guard","defaultValue":{"public":"meta.ignoreAccess","unauthenticated":"redirect /auth/login with redirect query","authenticatedFirstVisit":"load user, roles, routes, menus and mark isAccessChecked","authenticatedChecked":"allow"},"requiredWhen":"every navigation","description":"项目访问守卫的认证和首次动态路由流程。","allowedValues":[],"safetyNotes":["动态菜单请求失败会使导航失败并在后续重试。","decodeURIComponent 未保护，畸形 redirect 可能抛异常。"],"sources":[{"path":"apps/web-antd/src/router/guard.ts","lines":"47-120"}],"category":"routing","scope":"project"},
    {"key":"router.resetRoutes","type":"function","defaultValue":"defined but never called","requiredWhen":"logout, account switch or permission refresh","description":"删除非静态命名路由的公共清理能力。","allowedValues":[],"safetyNotes":["项目 logout 只重置 stores，不删除 Router 中动态路由；跨账号可能残留旧路由匹配。","后端仍必须独立鉴权。"],"sources":[{"path":"apps/web-antd/src/router/index.ts","lines":"32-37"},{"path":"packages/utils/src/helpers/reset-routes.ts","lines":"8-31"},{"path":"apps/web-antd/src/store/auth.ts","lines":"99-117"}],"category":"routing","scope":"project"},
    {"key":"sse.businessConnection","type":"EventSource with one-time ticket","defaultValue":{"ticketEndpoint":"POST /ypbin/sse/ticket","subscribeEndpoint":"GET /ypbin/sse/subscribe?ticket=<ticket>","event":"message-unread"},"requiredWhen":"authenticated basic layout is mounted","description":"实际业务 SSE 链路：先用 Bearer 请求 ticket，再用原生 EventSource 订阅。","allowedValues":[],"safetyNotes":["ticket 位于 query，需后端短 TTL、一次性、用户绑定及日志脱敏。","前端未使用 ticket expiresIn。","只监听 message-unread，不处理默认 message 事件。"],"sources":[{"path":"apps/web-antd/src/api/system/message.ts","lines":"56-61"},{"path":"apps/web-antd/src/store/message.ts","lines":"110-169"}],"category":"sse","scope":"project"},
    {"key":"sse.reconnect","type":"exponential backoff","defaultValue":{"formula":"min(1000 * 2^retryCount, 30000)","sequenceMs":[1000,2000,4000,8000,16000,30000],"maxAttempts":"unlimited","jitter":false},"requiredWhen":"EventSource errors or ticket request fails","description":"业务 SE 自定义重连策略；error 时主动关闭浏览器 EventSource。","allowedValues":[],"safetyNotes":["无 jitter，服务恢复时可能同步重连。","服务端 retry 指令不主导。","没有最大次数。"],"sources":[{"path":"apps/web-antd/src/store/message.ts","lines":"24,110-169"}],"category":"sse","scope":"project"},
    {"key":"sse.eventHandling","type":"event listener behavior","defaultValue":{"onOpen":"retryCount=0","onMessageUnread":"refresh latest 10 messages and unread count","payloadUsed":false,"lastEventIdUsed":false},"requiredWhen":"message-unread arrives","description":"每次未读事件触发两项并行 HTTP 刷新。","allowedValues":[],"safetyNotes":["无 debounce、请求合并、取消和响应版本保护，事件突发可产生并发刷新。"],"sources":[{"path":"apps/web-antd/src/store/message.ts","lines":"54-66,148-155"}],"category":"sse","scope":"project"},
    {"key":"sse.recoveryGaps","type":"capability gap list","defaultValue":["no heartbeat watchdog","no Last-Event-ID","no reconnect-success refresh","no offline/online listener","no visibilitychange listener","no missed-event cursor"],"requiredWhen":"reliable delivery across disconnects is required","description":"当前业务 SE 不具备的断线检测和补偿能力。","allowedValues":[],"safetyNotes":["断线期间最后一次消息若重连后无新事件，未读数可能长期过期。","半开连接识别依赖浏览器/TCP/代理/服务端。"],"sources":[{"path":"apps/web-antd/src/store/message.ts","lines":"110-193"}],"category":"sse","scope":"project"},
    {"key":"sse.lifecycle","type":"layout/store lifecycle","defaultValue":{"start":"basic layout mount when userId exists","stop":"layout unmount or messageStore.$reset","versionGuard":true},"requiredWhen":"user session changes","description":"布局挂载启动、卸载和登出清理 EventSource。","allowedValues":[],"safetyNotes":["close 后立即 start 可能受上一轮 seInitializing 影响而丢启动。","loginExpiredMode=modal 时不一定卸载布局或关闭旧连接。"],"sources":[{"path":"apps/web-antd/src/layouts/basic.vue","lines":"49-69,115-118"},{"path":"apps/web-antd/src/store/message.ts","lines":"177-193"}],"category":"sse","scope":"project"},
    {"key":"sse.requestSE","type":"fetch ReadableStream chunk reader","defaultValue":{"methods":["requestSE","postSE"],"accept":"text/event-stream","protocolParsing":false},"requiredWhen":"public streaming request helper is explicitly used","description":"上游同名能力只回调网络 chunk，不解析标准 SSE 帧；当前业务未使用。","allowedValues":[],"safetyNotes":["不解析 event/data/id/retry/帧边界/comment。","无 signal 时不能主动 abort。","绝对 baseURL 加以 / 开头 path 可能丢 base path。"],"sources":[{"path":"packages/effects/request/src/request-client/modules/se.ts","lines":"45-132"},{"path":"packages/effects/request/src/request-client/request-client.ts","lines":"48-51,90-93"}],"category":"sse","scope":"upstream"},
