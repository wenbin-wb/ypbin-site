    {"key":"i18n.thirdPartyLocales","type":"locale adapters","defaultValue":{"antDesign":"static zh_CN/en_US","dayjs":"dynamic zh-cn/en"},"requiredWhen":"locale changes","description":"切换 Ant Design Vue 和 Dayjs 语言。","allowedValues":["zh-CN","en-US"],"safetyNotes":["Dayjs 当前把动态 import 模块命名空间传给 dayjs.locale，而非 default 导出，实际可能无法正确切换。","未知 locale 时 Antd 保留上一次值。"],"sources":[{"path":"apps/web-antd/src/locales/index.ts","lines":"16-20,53-91"},{"path":"apps/web-antd/src/app.vue","lines":"33-39"}],"category":"i18n","scope":"project"},
